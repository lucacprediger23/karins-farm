{
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": [
    "fra1"
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/story",
      "destination": "/pages/povestea",
      "permanent": false
    },
    {
      "source": "/pages/story",
      "destination": "/pages/povestea",
      "permanent": false
    },
    {
      "source": "/povestea",
      "destination": "/pages/povestea",
      "permanent": false
    },
    {
      "source": "/privacy",
      "destination": "/policies/privacy-policy",
      "permanent": false
    },
    {
      "source": "/privacy-ro",
      "destination": "/policies/privacy-policy",
      "permanent": false
    },
    {
      "source": "/terms",
      "destination": "/policies/terms-of-service",
      "permanent": false
    },
    {
      "source": "/terms-ro",
      "destination": "/policies/terms-of-service",
      "permanent": false
    },
    {
      "source": "/cookies",
      "destination": "/pages/cookies",
      "permanent": false
    },
    {
      "source": "/cookies-ro",
      "destination": "/pages/cookies",
      "permanent": false
    },
    {
      "source": "/products",
      "destination": "/products/karins-farm",
      "permanent": false
    }
  ]
}